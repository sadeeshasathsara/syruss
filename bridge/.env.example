# Local infrastructure (bridge/docker-compose.yml). Copy to bridge/.env; docker compose reads it
# automatically. The database and MinIO credentials here must match server/.env and agentic_framework/.env.

# --- PostgreSQL (with pgvector and Apache AGE) ---------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=doc_intelligence
POSTGRES_PORT=5432

# --- MinIO ----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Kafka ----------------------------------------------------------------------------
KAFKA_PORT=9092
# The host other services use to reach Kafka
KAFKA_ADVERTISED_HOST=localhost
# Any base64 UUID; keep it stable once the data volume exists
KAFKA_CLUSTER_ID=4L622nShTUiT8tOxvfutew

# --- Keycloak (authentication) ---------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
# Public origins of the two web apps (exact redirect URIs are derived from these)
SYRUSS_SITE_URL=http://localhost:3100
SYRUSS_APP_URL=http://localhost:3000
# Confidential client secrets; the same values go in site/.env.local and www/.env.local
SYRUSS_SITE_CLIENT_SECRET=change-me
SYRUSS_APP_CLIENT_SECRET=change-me
# Google sign-in (leave "unset" to keep the Google button disabled)
GOOGLE_CLIENT_ID=unset
GOOGLE_CLIENT_SECRET=unset
