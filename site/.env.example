# Syruss site (landing, onboarding, invitations). Copy to site/.env.local.

# Where this app is served (Keycloak sends people back here) and where the Syruss app is served
APP_ORIGIN=http://localhost:3100
SITE_ORIGIN=http://localhost:3100
WORKSPACE_APP_URL=http://localhost:3000

# The core API (server-side only; the browser never talks to it)
API_ORIGIN=http://localhost:8000

# Keycloak: the realm issuer and this app's confidential client (see bridge/keycloak)
OIDC_ISSUER=http://localhost:8080/realms/syruss
OIDC_CLIENT_ID=syruss-site
OIDC_CLIENT_SECRET=change-me   # same as SYRUSS_SITE_CLIENT_SECRET in bridge/.env

# Encrypts the session cookie. At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=syruss_site_session
