# The mail service: every email Syruss sends goes through it (see README.md). Copy to mail/.env.

# "development" (your machine), "test" (the test server) or "production". The test server and production refuse to start
# with the development values below: POSTGRES_PASSWORD, an empty MAIL_SECRETS_KEY, MAIL_BACKEND other than smtp,
# MAIL_SMTP_HOST localhost, MAIL_FROM at a .local domain.
ENV=development

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Its own database on the same Postgres as the core server (created on first start)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MAIL_DB=syruss_mail

# Seals connected accounts' passwords and Google sign-ins. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it: changing it means connecting the accounts again.
MAIL_SECRETS_KEY=

# The account from the environment: what every purpose sends through until an account connected in the admin app takes
# over. Locally, Mailpit (bridge/docker-compose.yml) catches everything on port 1025: see http://localhost:8025.
# smtp: send through MAIL_SMTP_*   console: only log the message   memory: tests.
MAIL_BACKEND=smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURITY=none
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=no-reply@syruss.local
MAIL_FROM_NAME=Syruss

# The account from the environment can also read a mailbox (IMAP, read-only) for Support, until an account connected in
# the admin app takes over. Gmail: imap.gmail.com, port 993, an App Password. Empty host: it doesn't read.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=true
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_POLL_SECONDS=60

# The internal API the server uses: the same MAIL_SERVICE_TOKEN as in server/.env (python -c "import secrets;
# print(secrets.token_urlsafe(32))"). Only the server reaches it.
MAIL_API_HOST=127.0.0.1
MAIL_API_PORT=8100
MAIL_SERVICE_TOKEN=

# Google mail: an OAuth client ("Web application") in Google Cloud, with <PUBLIC_ADMIN_URL>/email/google as its
# redirect URI (http://localhost:3200/email/google locally). Enable the Gmail API in the same project. A Google Workspace
# account with the OAuth app set to Internal needs no review from Google; a personal Gmail works while the app is in
# Testing (add yourself as a test user), but Google ends its sign-in every 7 days, so reconnect it from the Email page.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# The SMTP door for Keycloak: Keycloak signs in with this login and sends From MAIL_FROM; its emails then leave like all
# the others. `python bridge/keycloak/harden.py --smtp` points Keycloak here. 0 switches it off.
MAIL_RELAY_HOST=127.0.0.1
MAIL_RELAY_PORT=2525
MAIL_RELAY_USERNAME=keycloak
MAIL_RELAY_PASSWORD=
