# The mail service: every email Syruss sends goes through it (see README.md). Copy to mail/.env.

# "development" (your machine), "test" (the test server) or "production". The test server and production refuse to start
# with the development values below: POSTGRES_PASSWORD, an empty MAIL_SECRETS_KEY, MAIL_BACKEND other than none,
# MAIL_FROM at a .local domain.
ENV=development

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Its own database on the same Postgres as the core server (created on first start)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MAIL_DB=syruss_mail

# Seals everything secret kept in the database: accounts' passwords and sign-ins, the key people seal secrets to, and
# mail read from mailboxes. Fernet keys, comma-separated, NEWEST FIRST. Make one with `python -m mail keygen`.
# To rotate: put a new key in front and keep the old ones after it (they still open what they sealed). Losing every key
# loses what they sealed (accounts must be connected again), so keep them somewhere safe apart from the database.
MAIL_MASTER_KEYS=
# The single key from before MAIL_MASTER_KEYS: still honoured, and it still opens what it sealed.
MAIL_SECRETS_KEY=

# The server's public signing key (base64). The server signs each command it sends (connect a mailbox, change a job) and
# only a command signed with the matching private key is carried out. Empty: no command is accepted.
MAIL_TRUSTED_SERVER_KEY=

# Before a mailbox is connected, mail waits (nothing is sent). No mail password or server lives in an environment file: connect
# the first mailbox with `python -m mail connect` (or in the admin app, Email), then everything is set up there.
# none: wait for a mailbox   console: only log the message (local work)   memory: tests.
# Locally, Mailpit (bridge/docker-compose.yml) catches mail on port 1025 (see http://localhost:8025): after starting, run
#   python -m mail connect --address no-reply@syruss.local --smtp-host localhost --smtp-port 1025 --smtp-security none
MAIL_BACKEND=none
# The address mail is shown as coming from until a connected mailbox says otherwise, and the name it is sent as
MAIL_FROM=no-reply@syruss.local
MAIL_FROM_NAME=Syruss
# Where replies to app mail go (empty: to MAIL_FROM)
MAIL_REPLY_TO=

# Support tickets by email. Customers write to SUPPORT_EMAIL_ADDRESS (empty: MAIL_FROM); connect that mailbox in the admin
# app (Email) for the "support" purpose. Support mail is sent as SUPPORT_FROM_NAME and answered at that address. The server
# asks this service for the address (it has no setting of its own).
SUPPORT_EMAIL_ADDRESS=
SUPPORT_FROM_NAME=Syruss Support

MAIL_POLL_SECONDS=60

# Google mail: an OAuth client ("Web application") in Google Cloud, with <PUBLIC_ADMIN_URL>/email/google as its
# redirect URI (http://localhost:3200/email/google locally). Enable the Gmail API in the same project. A Google Workspace
# account with the OAuth app set to Internal needs no review from Google; a personal Gmail works while the app is in
# Testing (add yourself as a test user), but Google ends its sign-in every 7 days, so reconnect it from the Email page.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# The SMTP door for Keycloak: Keycloak signs in with this login and sends From MAIL_FROM; its emails then leave like all
# the others. `python bridge/keycloak/harden.py --smtp` points Keycloak here. 0 switches it off.
MAIL_RELAY_HOST=127.0.0.1
MAIL_RELAY_PORT=2525
MAIL_RELAY_USERNAME=keycloak
MAIL_RELAY_PASSWORD=

# Kafka login: off by default (a broker on a private network). On anything else turn on TLS and SASL; see README.md, "Kafka security".
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=mail
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_FILE=
