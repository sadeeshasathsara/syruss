# System admin app (admin/). Copy to admin/.env.local. Restart `next dev` after changing it.

# Where the core API runs (server side only: the app proxies /api/v1/sysadmin to it)
API_ORIGIN=http://localhost:8000

# --- Sign-in (Keycloak) and the site ------------------------------------------------------
# Where this app is served (Keycloak sends people back here) and where the site is served (sign-in problems, signed out)
APP_ORIGIN=http://localhost:3200
SITE_ORIGIN=http://localhost:3100
SITE_URL=http://localhost:3100
# The realm and this app's confidential client. It signs in with a one-time code every time: run
# `python bridge/keycloak/harden.py` once so the running realm has the client and its sign-in flow.
OIDC_ISSUER=http://localhost:8080/realms/syruss
OIDC_CLIENT_ID=syruss-admin
OIDC_CLIENT_SECRET=change-me   # same as SYRUSS_ADMIN_CLIENT_SECRET in bridge/.env (dev default: dev-admin-secret-change-me)
# Encrypts the session cookie: at least 32 random characters, different from the other apps'
SESSION_SECRET=
SESSION_COOKIE_NAME=syruss_admin_session
