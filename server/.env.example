# Core API (server/). Copy to server/.env and fill in. Every value here is a setting in
# app/core/config.py; anything left out takes the default shown.

# --- API ---------------------------------------------------------------------
PROJECT_NAME=Adaptive AI Document Intelligence Platform
API_V1_PREFIX=/api/v1
AGENT_API_PREFIX=/internal/agent/v1
# Browser origins allowed to call the API directly, comma-separated. "*" is never accepted (requests carry credentials).
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# "development" (your machine), "test" (the test server) or "production". The test server and production refuse to start
# while any development value is left: the passwords and secrets below, SECRETS_ENCRYPTION_KEY unset, PUBLIC_*_URL,
# OIDC_ISSUER or CORS_ORIGINS not https or still localhost. Production also refuses
# weakened security switches (REQUIRE_*) and hides the API docs.
ENV=development

# --- PostgreSQL (must match bridge/.env) ---------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=doc_intelligence
# Apply migrations when the API starts (production runs `alembic upgrade head` as its own step: false)
AUTO_MIGRATE=true

# --- MinIO / S3 (must match bridge/.env) ----------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_SECURE=false
MINIO_BUCKET_NAME=documents

# --- Kafka ---------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AGENT_EVENTS_TOPIC=agent.events
AGENT_TELEMETRY_TOPIC=agent.telemetry

# --- Secrets -------------------------------------------------------------------
# Development: the agent-token keypair is derived from this secret (the agent service shares it).
AGENT_TOKEN_SECRET=change-me
AGENT_TOKEN_TTL_SECONDS=86400
# Production: an Ed25519 keypair. The core signs with the private key; the agent service gets ONLY the public key.
#   openssl genpkey -algorithm ed25519 -out agent-token.pem && openssl pkey -in agent-token.pem -pubout -out agent-token.pub
# Paste the PEMs with newlines written as 
.
AGENT_TOKEN_PRIVATE_KEY=
AGENT_TOKEN_PUBLIC_KEY=
# Fernet key that encrypts data-source credentials and webhook secrets. Empty in development
# (derived from AGENT_TOKEN_SECRET); set one in production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- Sign-in (Keycloak is the only way in) ----------------------------------------------
OIDC_ISSUER=http://localhost:8080/realms/syruss
# Empty: <issuer>/protocol/openid-connect/certs
OIDC_JWKS_URL=
OIDC_AUDIENCE=syruss-api
OIDC_ALLOWED_CLIENTS=syruss-site,syruss-app,syruss-admin
# The system admin app's client: /api/v1/sysadmin answers only its tokens (it signs in with a one-time code)
OIDC_ADMIN_CLIENT=syruss-admin
# Keycloak subjects (the "sub" claim, see Keycloak > Users) of the people who run the platform itself. They are owners
# in the system admin app (admin/) and add the rest of the platform staff there. Comma-separated.
PLATFORM_ADMIN_USER_IDS=
# Usually left empty. Platform staff are added from the server, which also makes their sign-in (a staff account is
# separate from any customer account, so use an address that has none):  syruss staff add you@company.com
# (on a server: KEYCLOAK_ADMIN=... KEYCLOAK_ADMIN_PASSWORD=... python -m app.invite_staff you@company.com [role])
# Staff sign-ins must include a one-time code (run bridge/keycloak/harden.py so Keycloak reports it in the token), last at most
# STAFF_SESSION_HOURS, and the admin app signs out after STAFF_IDLE_MINUTES without use. If the platform loses the second
# owner its approval rule needs, turn the rule off from the server:  python -m app.approvals off
STAFF_REQUIRE_TWO_STEP=true
STAFF_SESSION_HOURS=8
STAFF_IDLE_MINUTES=30
# Accepting an invitation proves you own the invited address. Turn off only where Keycloak can't verify emails (no SMTP yet).
INVITE_REQUIRE_VERIFIED_EMAIL=true
INVITE_DAYS=7
WS_TICKET_TTL_SECONDS=30

# --- Email -----------------------------------------------------------------------
# The server never talks to a mail server: it queues each email for the mail service (mail/), which holds every mail
# account and sends it (set its mail server in mail/.env). Run it locally with `python -m mail`.
# service: queue for the mail service   console: only log the message (no mail service)   memory: tests.
MAIL_BACKEND=service
# The mail service's internal API (the admin app's Email page, and mail read from mailboxes), and the key to it: the
# same MAIL_SERVICE_TOKEN as in mail/.env. Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAIL_SERVICE_URL=http://localhost:8100
MAIL_SERVICE_TOKEN=
# Who mail is from (MAIL_FROM, MAIL_FROM_NAME, MAIL_REPLY_TO) and the support mailbox's address (SUPPORT_EMAIL_ADDRESS,
# SUPPORT_FROM_NAME) are settings of the mail service, in mail/.env: the server asks it for the two addresses it needs.
# Support tickets (customers' requests to the Syruss team, answered in the admin app under Support): connect the support
# mailbox in the admin app (Email, for "Support"); replies to it are added to their ticket (matched by the [#T-1042] in
# the subject or the email headers) and mail from new senders opens a ticket.
# Links in emails point here (invitations open at <PUBLIC_SITE_URL>/invite/<token>)
PUBLIC_SITE_URL=http://localhost:3100
# The main app, for links to an organization's own pages (invoices and billing alerts open at <PUBLIC_APP_URL>/<org>/settings/billing)
PUBLIC_APP_URL=http://localhost:3000
# The system admin app, for links in emails to Syruss's staff (a payment slip to check)
PUBLIC_ADMIN_URL=http://localhost:3200
# How invoices can be paid: bank_transfer (the customer sends the slip), staff_recorded (cash or cheque), card (Stripe)
BILLING_METHODS=bank_transfer,staff_recorded
# Card payments (add "card" above): test-mode keys while testing. Locally, this prints the webhook secret to use:
#   stripe listen --forward-to localhost:8000/api/v1/billing/webhooks/stripe --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,payment_intent.succeeded,charge.refunded,charge.dispute.created,charge.dispute.closed
# In the Stripe dashboard, the production webhook listens to the same events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# An invitation email can be sent again this often
MAIL_RESEND_SECONDS=60

# --- Agent memory and platform jobs ----------------------------------------------
# Must match the agent's EMBEDDING_DIM
EMBEDDING_DIM=768
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# --- Data sources the server fetches -----------------------------------------------
KNOWLEDGE_SOURCE_MAX_BYTES=5000000
KNOWLEDGE_SOURCE_TIMEOUT_SECONDS=20
# Allow fetching from private/loopback addresses (an API on your own machine). Development only.
KNOWLEDGE_SOURCES_ALLOW_PRIVATE_HOSTS=false

# --- Connections: Intake & Reliable Publishing ----------------------------------
# Address shown to senders and used in documentation/API links
PUBLIC_API_URL=http://localhost:8000
# For presigned S3 uploads from external clients (empty uses MINIO_ENDPOINT)
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=false
# Trust X-Forwarded-For (only set to true behind a reverse proxy you control; its last entry, the one that proxy adds, is used)
TRUST_PROXY_HEADERS=false
# Maximum uncompressed image pixels allowed (protects against decompression bombs)
INTAKE_MAX_PIXELS=100000000
INTAKE_UPLOAD_MINUTES=15

# Virus scanning hook (empty disables scanning; type/size validation still applies)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Inbound email intake (built-in aiosmtpd receiver). Set port > 0 to enable.
INTAKE_SMTP_PORT=0
INTAKE_SMTP_HOST=0.0.0.0
INTAKE_EMAIL_DOMAIN=intake.syruss.local

# Inbound SFTP intake (built-in asyncssh server). Set port > 0 to enable.
INTAKE_SFTP_PORT=0
INTAKE_SFTP_HOST=0.0.0.0
INTAKE_SFTP_HOST_KEY=
INTAKE_SFTP_PUBLIC_HOST=

# Delivery queue worker (publishes approved records to destinations)
DELIVERY_WORKER_ENABLED=true
DELIVERY_POLL_SECONDS=2.0
DELIVERY_TIMEOUT_SECONDS=20
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_BREAKER_FAILURES=10
# Public API base URL used for OAuth callbacks (empty uses PUBLIC_API_URL)
OAUTH_REDIRECT_BASE=
