# Core API (server/). Copy to server/.env and fill in. Every value here is a setting in
# app/core/config.py; anything left out takes the default shown.

# --- API ---------------------------------------------------------------------
PROJECT_NAME=Adaptive AI Document Intelligence Platform
API_V1_PREFIX=/api/v1
AGENT_API_PREFIX=/internal/agent/v1
# Browser origins allowed to call the API directly, comma-separated. "*" is never accepted (requests carry credentials).
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# "development" or "production". Production hides the destructive development routes.
ENV=development

# --- PostgreSQL (must match bridge/.env) ---------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=doc_intelligence
# Apply migrations when the API starts (production runs `alembic upgrade head` as its own step: false)
AUTO_MIGRATE=true

# --- MinIO / S3 (must match bridge/.env) ----------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_SECURE=false
MINIO_BUCKET_NAME=documents

# --- Kafka ---------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AGENT_EVENTS_TOPIC=agent.events
AGENT_TELEMETRY_TOPIC=agent.telemetry

# --- Secrets -------------------------------------------------------------------
# Development: the agent-token keypair is derived from this secret (the agent service shares it).
AGENT_TOKEN_SECRET=change-me
AGENT_TOKEN_TTL_SECONDS=86400
# Production: an Ed25519 keypair. The core signs with the private key; the agent service gets ONLY the public key.
#   openssl genpkey -algorithm ed25519 -out agent-token.pem && openssl pkey -in agent-token.pem -pubout -out agent-token.pub
# Paste the PEMs with newlines written as 
.
AGENT_TOKEN_PRIVATE_KEY=
AGENT_TOKEN_PUBLIC_KEY=
# Fernet key that encrypts data-source credentials and webhook secrets. Empty in development
# (derived from AGENT_TOKEN_SECRET); set one in production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# --- Sign-in (Keycloak is the only way in) ----------------------------------------------
OIDC_ISSUER=http://localhost:8080/realms/syruss
# Empty: <issuer>/protocol/openid-connect/certs
OIDC_JWKS_URL=
OIDC_AUDIENCE=syruss-api
OIDC_ALLOWED_CLIENTS=syruss-site,syruss-app
# Keycloak subjects (the "sub" claim, see Keycloak > Users) of the people who run the platform itself:
# platform-wide lessons, agent traces and the development-only reset. Comma-separated.
PLATFORM_ADMIN_USER_IDS=
# Accepting an invitation proves you own the invited address. Turn off only where Keycloak can't verify emails (no SMTP yet).
INVITE_REQUIRE_VERIFIED_EMAIL=true
INVITE_DAYS=7
WS_TICKET_TTL_SECONDS=30

# --- Email -----------------------------------------------------------------------
# smtp: send through SMTP_*   console: only log the message   memory: tests.
# Locally, Mailpit (bridge/docker-compose.yml) catches everything: inbox at http://localhost:8025.
# Production needs a real provider: MAIL_BACKEND=smtp, SMTP_SECURITY=starttls (or ssl), your credentials, and a MAIL_FROM
# on a domain you have set up SPF and DKIM for.
# Gmail (small volumes): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls, SMTP_USERNAME=<the address>,
# SMTP_PASSWORD=<an App Password: Google Account > Security > 2-Step Verification > App passwords>, MAIL_FROM=<the same address>.
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@syruss.local
MAIL_FROM_NAME=Syruss
MAIL_REPLY_TO=
# Links in emails point here (invitations open at <PUBLIC_SITE_URL>/invite/<token>)
PUBLIC_SITE_URL=http://localhost:3100
# An invitation email can be sent again this often
MAIL_RESEND_SECONDS=60

# --- Agent memory and platform jobs ----------------------------------------------
# Must match the agent's EMBEDDING_DIM
EMBEDDING_DIM=768
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# --- Data sources the server fetches -----------------------------------------------
KNOWLEDGE_SOURCE_MAX_BYTES=5000000
KNOWLEDGE_SOURCE_TIMEOUT_SECONDS=20
# Allow fetching from private/loopback addresses (an API on your own machine). Development only.
KNOWLEDGE_SOURCES_ALLOW_PRIVATE_HOSTS=false

# --- Connections: Intake & Reliable Publishing ----------------------------------
# Address shown to senders and used in documentation/API links
PUBLIC_API_URL=http://localhost:8000
# For presigned S3 uploads from external clients (empty uses MINIO_ENDPOINT)
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=false
# Trust X-Forwarded-For (only set to true behind a reverse proxy you control)
TRUST_PROXY_HEADERS=false
# Maximum uncompressed image pixels allowed (protects against decompression bombs)
INTAKE_MAX_PIXELS=100000000
INTAKE_UPLOAD_MINUTES=15

# Virus scanning hook (empty disables scanning; type/size validation still applies)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Inbound email intake (built-in aiosmtpd receiver). Set port > 0 to enable.
INTAKE_SMTP_PORT=0
INTAKE_SMTP_HOST=0.0.0.0
INTAKE_EMAIL_DOMAIN=intake.syruss.local

# Inbound SFTP intake (built-in asyncssh server). Set port > 0 to enable.
INTAKE_SFTP_PORT=0
INTAKE_SFTP_HOST=0.0.0.0
INTAKE_SFTP_HOST_KEY=
INTAKE_SFTP_PUBLIC_HOST=

# Delivery queue worker (publishes approved records to destinations)
DELIVERY_WORKER_ENABLED=true
DELIVERY_POLL_SECONDS=2.0
DELIVERY_TIMEOUT_SECONDS=20
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_BREAKER_FAILURES=10
# Public API base URL used for OAuth callbacks (empty uses PUBLIC_API_URL)
OAUTH_REDIRECT_BASE=
