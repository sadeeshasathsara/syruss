# Web app (www/). Copy to www/.env.local. Restart `next dev` after changing it; NEXT_PUBLIC_*
# values are built into the browser code, so never put secrets in them.

# Where the core API runs (server side only: the app proxies /api and /ws to it)
API_ORIGIN=http://localhost:8000


# --- Sign-in (Keycloak) and the site ------------------------------------------------------
# Where this app is served (Keycloak sends people back here) and where the site is served
APP_ORIGIN=http://localhost:3000
SITE_ORIGIN=http://localhost:3100
SITE_URL=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# The realm and this app's confidential client (bridge/keycloak)
OIDC_ISSUER=http://localhost:8080/realms/syruss
OIDC_CLIENT_ID=syruss-app
OIDC_CLIENT_SECRET=change-me   # same as SYRUSS_APP_CLIENT_SECRET in bridge/.env
# Encrypts the session cookie: at least 32 random characters
SESSION_SECRET=
SESSION_COOKIE_NAME=syruss_app_session
