# Workspace agent service (agentic_framework/). Copy to agentic_framework/.env and fill in.
# Every value here is a setting in config.py; anything left out takes the default shown.
# The agent never connects to the core server's database: it acts through the Agent Tool API.

# --- Core server and Kafka ---------------------------------------------------------
CORE_API_URL=http://localhost:8000/internal/agent/v1
CORE_API_TIMEOUT_SECONDS=60
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AGENT_EVENTS_TOPIC=agent.events
AGENT_TELEMETRY_TOPIC=agent.telemetry
AGENT_DLQ_TOPIC=agent.events.dlq
CONSUMER_GROUP=workspace-agents

# --- Event authenticity ------------------------------------------------------------
# Every event carries a token the core server signed. This service verifies it with the PUBLIC key only.
# Production: the Ed25519 public key (PEM, newlines as 
). Development: leave empty and set the same
# AGENT_TOKEN_SECRET as server/.env (a keypair is derived from it).
ENV=development
AGENT_TOKEN_PUBLIC_KEY=
AGENT_TOKEN_SECRET=change-me

# --- The agent's own memory database (created on the same Postgres server) ---------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AGENT_MEMORY_DB=agent_memory

# --- Model ---------------------------------------------------------------------------
# Provider: gemini | anthropic | openai. Change the model by changing these and restarting.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Alternative name for the Gemini key (either works)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
# The analyst (custom screens, "what stands out?") runs warmer so it thinks of new things to look at. Its figures
# still come from the platform's tools. Some models (for example gemini-3.5-flash-lite) fix their own sampling and
# ignore temperature: set ANALYTICS_MODEL to one that honours it for the warmer behaviour to take effect.
ANALYTICS_TEMPERATURE=0.7
ANALYTICS_MODEL=
# A cheaper model for chat replies (same provider); empty uses the work model
CHAT_MODEL=
# USD per million tokens, as JSON {"model": [input, output]}; without it costs are left empty
MODEL_PRICES={}

# --- Memory embeddings (must match the core server's EMBEDDING_DIM) ---------------------
EMBEDDINGS_ENABLED=true
# Empty: the provider's default embedding model
EMBEDDING_MODEL=
EMBEDDING_DIM=768
SUMMARY_BATCH=10

# --- Limits per run ----------------------------------------------------------------------
MAX_STEPS=40
MAX_RUN_SECONDS=600
MODEL_CALL_TIMEOUT_SECONDS=120
MAX_OUTCOME_REMINDERS=2
MAX_IMAGES_IN_CONTEXT=4
FULL_TOOL_RESULTS=6
OLD_TOOL_RESULT_CHARS=600

# --- Delivery ---------------------------------------------------------------------------
MAX_ATTEMPTS=3
MAX_PARALLEL_WORKSPACES=4
